# ===== 应用 =====
APP_NAME=MythWeaver
DEBUG=true
# 数据目录（相对 backend/ 或绝对路径均可）；留空 DATABASE_URL 时自动使用 data/mythweaver.db
DATA_DIR=../data
# DATABASE_URL=

# ===== Token 预算 / 并发 =====
# Kimi 等组织并发上限常为 3：入库章节并发与 chat 全局并发建议 ≤2，留余量
CONTEXT_TOKEN_BUDGET=16000
INGEST_CONCURRENCY=2
LLM_MAX_CONCURRENCY=2
# 向量化独立并发（勿抬高 LLM_MAX_CONCURRENCY；Kimi 组织上限常为 3）
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_BATCH_SIZE=16

# ===== 摘要模型（廉价）=====
SUMMARY_PROVIDER=openai
SUMMARY_BASE_URL=https://api.openai.com/v1
SUMMARY_API_KEY=sk-your-summary-key
SUMMARY_MODEL=gpt-4o-mini

# ===== 生成模型（高质量）=====
GENERATION_PROVIDER=openai
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=sk-your-generation-key
GENERATION_MODEL=gpt-4o

# ===== Embedding（OpenAI 兼容）=====
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
# 智谱 embedding-3 示例：BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3 且 EMBEDDING_DIMS=2048

# ===== Kimi / Moonshot（OpenAI 兼容；国内 api.moonshot.cn，国际 api.moonshot.ai）=====
# SUMMARY_PROVIDER=openai
# SUMMARY_BASE_URL=https://api.moonshot.cn/v1
# SUMMARY_API_KEY=sk-your-moonshot-key
# SUMMARY_MODEL=kimi-k2.6
# GENERATION_PROVIDER=openai
# GENERATION_BASE_URL=https://api.moonshot.cn/v1
# GENERATION_API_KEY=sk-your-moonshot-key
# GENERATION_MODEL=kimi-k2.6
# 注意：Kimi 官方目前无 embedding API，EMBEDDING_* 需另配 OpenAI 兼容向量服务

# ===== Anthropic 示例（将 PROVIDER 改为 anthropic 即可）=====
# SUMMARY_PROVIDER=anthropic
# SUMMARY_BASE_URL=https://api.anthropic.com
# SUMMARY_API_KEY=sk-ant-your-key
# SUMMARY_MODEL=claude-3-5-haiku-latest
# GENERATION_PROVIDER=anthropic
# GENERATION_BASE_URL=https://api.anthropic.com
# GENERATION_API_KEY=sk-ant-your-key
# GENERATION_MODEL=claude-3-5-sonnet-latest

# ===== 限流（RPM/TPM + 429 指数退避；并发见上方 LLM_MAX_CONCURRENCY）=====
LLM_RPM=60
LLM_TPM=100000
LLM_MAX_RETRIES=5
# 流式 HTTP：连接短超时；读超时按 chunk 续命（秒）
LLM_CONNECT_TIMEOUT=20
LLM_STREAM_READ_TIMEOUT=180
# 续写 SSE 心跳间隔（秒）；前端空闲超时约 45s
SSE_HEARTBEAT_INTERVAL=12

# ===== 成本单价（USD / 1M tokens，可按实际调整）=====
COST_SUMMARY_INPUT=0.15
COST_SUMMARY_OUTPUT=0.60
COST_GENERATION_INPUT=2.50
COST_GENERATION_OUTPUT=10.00
COST_EMBEDDING=0.02
